@@ -0,0 +1,58 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! Compatibility with COD Zombies 1.5's S3E data loader.
+
+use crate::mach_o::MachO;
+use crate::mem::{ConstPtr, Mem, MutPtr};
+
+/// Must run before Dyld rewrites the executable's import stubs, and before
+/// the CPU can cache instructions from the executable.
+pub(super) fn preserve_loader_checksum(bundle_id: &str, executable: &MachO, mem: &mut Mem) {
+    if bundle_id != "com.activision.callofduty" {
+        return;
+    }
+    let (Some(text), Some(code), Some(data)) = (
+        executable.get_section("__text"),
+        executable.get_section("s3e_code"),
+        executable.get_section("s3e_data"),
+    ) else {
+        return;
+    };
+    // The routine address and algorithm below belong to this exact layout.
+    // In particular, do not apply them to the already working 1.1 release.
+    if (
+        text.addr, text.size, code.addr, code.size, data.addr, data.size,
+    ) != (0x2040, 0x58084, 0x65f00, 0x25e6e0, 0xa0e000, 0xc670)
+    {
+        log!("CODZ TRACE10: checksum workaround skipped for different game layout");
+        return;
+    }
+
+    // The routine at 0x8fc4 hashes every byte from __text through s3e_code,
+    // including __symbol_stub4. Its result seeds the data decoder at 0x9198.
+    // Dyld replaces those stubs with SVCs, which changes the seed and silently
+    // corrupts the decoded data. Preserve the pre-link result instead.
+    let checksum = mem
+        .bytes_at(
+            ConstPtr::from_bits(text.addr),
+            code.next_section_addr() - text.addr,
+        )
+        .iter()
+        .fold(1234u32, |hash, &byte| {
+            hash.wrapping_mul(31).wrapping_add(u32::from(byte))
+        });
+    if checksum != 0x37fcb7b1 || mem.read(ConstPtr::<u32>::from_bits(0x8fc4)) != 0xe92d40f0 {
+        log!("CODZ TRACE10: checksum workaround skipped for unrecognized code ({checksum:#010x})");
+        return;
+    }
+
+    // A32: ldr r0, [pc]; bx lr; .word checksum. Only the in-memory checksum
+    // routine changes; the data decoder and the game file remain intact.
+    for (index, word) in [0xe59f0000, 0xe12fff1e, checksum].into_iter().enumerate() {
+        mem.write(MutPtr::<u32>::from_bits(0x8fc4 + index as u32 * 4), word);
+    }
+    log!("CODZ TRACE10 ORIGINAL CODE CHECKSUM: {checksum:#010x}; S3E loader compatibility applied");
+}
