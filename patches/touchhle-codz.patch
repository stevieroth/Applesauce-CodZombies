 //! `dlfcn.h` (`dlopen()` and friends)
 
 use crate::dyld::{export_c_func, FunctionExports};
-use crate::mem::{ConstPtr, MutVoidPtr, Ptr};
+use crate::mem::{ConstPtr, MutPtr, MutVoidPtr, Ptr};
 use crate::Environment;
 
 const RTLD_DEFAULT: MutVoidPtr = Ptr::from_bits(-2 as _);
@@ -54,8 +54,83 @@ fn dlclose(env: &mut Environment, handle: MutVoidPtr) -> i32 {
     0 // success
 }
 
+
+#[repr(C)]
+struct DlInfo {
+    dli_fname: ConstPtr<u8>,
+    dli_fbase: MutVoidPtr,
+    dli_sname: ConstPtr<u8>,
+    dli_saddr: MutVoidPtr,
+}
+
+impl crate::mem::SafeWrite for DlInfo {}
+
+fn dladdr(
+    env: &mut Environment,
+    address: ConstPtr<std::ffi::c_void>,
+    info: MutPtr<DlInfo>,
+) -> i32 {
+    let regs = env.cpu.regs();
+
+    log!(
+        "CODZ DLADDR ENTER: address={:?} info={:?} R0={:#x} R1={:#x} R2={:#x} R3={:#x} SP={:#x} LR={:#x} PC={:#x}",
+        address,
+        info,
+        regs[0],
+        regs[1],
+        regs[2],
+        regs[3],
+        regs[crate::cpu::Cpu::SP],
+        regs[crate::cpu::Cpu::LR],
+        regs[crate::cpu::Cpu::PC],
+    );
+
+    if info.is_null() {
+        log!("CODZ DLADDR: info is NULL -> returning 0");
+        return 0;
+    }
+
+    if env.bundle.bundle_identifier() == "com.activision.callofduty"
+        && address.to_bits() == 0x8f00
+        && env.cpu.regs()[crate::cpu::Cpu::LR] == 0x907c
+        && env.codz_trace.is_none()
+    {
+        let now = std::time::Instant::now();
+        env.codz_trace = Some((env.current_thread, now, now, 0));
+        log!("CODZ TRACE07 ARMED: high-runtime code dump and extended stepping");
+    }
+
+    let addr = 0x00008f80u32;
+    let len = 0x130usize;
+
+    let bytes: Vec<u8> = (0..len)
+        .map(|i| env.mem.read(ConstPtr::<u8>::from_bits(addr + i as u32)))
+        .collect();
+
+    log!("CODZ CALLSITE BLOCK {:#010x}: {:02x?}", addr, bytes);
+
+    let fname = env.mem.alloc_and_write_cstr(b"kiwi");
+
+    let result = DlInfo {
+        dli_fname: fname.cast_const(),
+        dli_fbase: MutVoidPtr::from_bits(0x1000),
+        dli_sname: ConstPtr::null(),
+        dli_saddr: MutVoidPtr::null(),
+    };
+
+    env.mem.write(info, result);
+
+    log!(
+        "CODZ DLADDR: returning success fname={:?} fbase=0x1000 sname=NULL saddr=NULL",
+        fname
+    );
+
+    1
+}
+
 pub const FUNCTIONS: FunctionExports = &[
     export_c_func!(dlopen(_, _)),
     export_c_func!(dlsym(_, _)),
     export_c_func!(dlclose(_)),
+    export_c_func!(dladdr(_, _)),
 ];
